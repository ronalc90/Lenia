{
  "name": "bioluma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bioluma \u2014 an incremental game grown from live Lenia artificial life.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "VITE_E2E=1 vite build && node tests/e2e/smoke.mjs",
    "e2e:sim": "node tests/e2e/sim-check.mjs --quick",
    "e2e:audio": "node tests/e2e/audio-render.mjs",
    "build:single": "SINGLE=1 vite build",
    "calibrate": "vite-node scripts/calibrate-detector.ts",
    "bot": "vite-node scripts/balance-bot.ts"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
