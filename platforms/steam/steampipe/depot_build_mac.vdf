// SteamPipe depot build script (template): macOS universal (Intel + Apple Silicon). Launch option: Bioluma.app.
// Rendered by platforms/steam/scripts/upload.sh as depot_build_<DEPOT_ID>.vdf.
"DepotBuild"
{
	"DepotID"	"__DEPOT_MAC__"
	"ContentRoot"	"../../../desktop/release-steam/mac-universal/"
	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"Recursive"	"1"
	}
	// Never ship debug symbols or the builder's metadata.
	"FileExclusion"	"*.pdb"
	"FileExclusion"	"builder-debug.yml"
	"FileExclusion"	"builder-effective-config.yaml"
}
